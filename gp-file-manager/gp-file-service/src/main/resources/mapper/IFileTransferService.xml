<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gp_01.file.service.mapper.FileBaseMapper">

    <update id="minusRefCountBatch" parameterType="java.util.List">
        update file_base set ref_count = ref_count - 1 where id in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                #{id}
            </foreach>
    </update>
</mapper>
